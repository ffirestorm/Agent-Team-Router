{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATR future runtime evaluation record (not produced by V0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "task_sha256", "environment", "policy_version", "model", "effort", "attempt", "success", "input_tokens", "output_tokens", "cost", "cost_source", "latency_ms", "failure_reason"],
  "properties": {
    "task_id": {"type": "string"},
    "task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment": {"type": "string", "description": "Reproducible image/repository commit identifier"},
    "policy_version": {"type": "string"},
    "model": {"type": "string"},
    "effort": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "success": {"type": "boolean"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost": {"type": ["number", "null"], "minimum": 0},
    "cost_source": {"type": ["string", "null"], "description": "Currency, measurement/estimate provenance and pricing date; null if unavailable"},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "failure_reason": {"type": ["string", "null"]}
  }
}
